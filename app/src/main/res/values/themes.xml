<?xml version="1.0" encoding="utf-8"?>

<resources>

    <style
        name="Theme.YarClassMaryam"
        parent="android:style/Theme.Material.Light.NoActionBar">

        <item name="android:fontFamily">sans</item>

        <item name="android:windowLightStatusBar">false</item>

        <item name="android:statusBarColor">@color/burgundy</item>

        <item name="android:navigationBarColor">@color/dark_brown</item>

    </style>


    <style
        name="Theme.YarClassMaryam.Starting"
        parent="Theme.SplashScreen">

        <item name="windowSplashScreenBackground">
            @color/cream
        </item>

        <item name="windowSplashScreenAnimatedIcon">
            @drawable/splash_icon
        </item>

        <item name="postSplashScreenTheme">
            @style/Theme.YarClassMaryam
        </item>

    </style>

</resources>
